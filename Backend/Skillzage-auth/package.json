{
  "name": "skillzage-auth",
  "version": "1.0.0",
  "description": "Authentication service for SkillzAge (Signup/Login) using Node, Express, PostgreSQL and JWT",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate:up": "node migrations/migrate.js up",
    "migrate:down": "node migrations/migrate.js down"
  },
  "keywords": ["auth", "jwt", "postgresql", "express"],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
